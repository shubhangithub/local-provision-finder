# Server only: never use a VITE_ prefix for a secret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Live meetings: Azure OpenAI is used when the endpoint and key are set, otherwise OpenAI (with the overrides below).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Realtime deployment name (default gpt-realtime-2.1) and the small model that trims candidate services.
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_FILTER_DEPLOYMENT=
# Optional: AZURE_OPENAI_TRANSCRIBE_MODEL (default whisper-1)
# OpenAI alternatives: OPENAI_REALTIME_MODEL=gpt-realtime-2.1, OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe, OPENAI_FILTER_MODEL=gpt-4.1-mini
# Web enrichment and follow-up calls: the deployed gov-service-enrich service. Server only.
GOV_HACK_URL=
GOV_HACK_API_TOKEN=
